# Local dev (outside docker): point at localhost; inside docker-compose the app service overrides this to host "db"
DATABASE_URL="postgresql://receptionist:receptionist@localhost:5432/receptionist"

# Free tier: https://console.groq.com/keys
GROQ_API_KEY="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"
# Override if Groq deprecates the default model again — check console.groq.com/docs/deprecations
GROQ_MODEL="openai/gpt-oss-120b"

# Optional fallback provider (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY="AQ.Ab8RN6JcuU6vm86KXXofpy0CwYtiQB3-c3tlSfHfiPZjMnvtuQ"
GEMINI_MODEL="gemini-2.5-flash"

PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API (tighten before any client-facing demo)
ALLOWED_ORIGINS="http://localhost:3000"

# Shared secret for the staff dashboard at /dashboard.html — pick any string.
# Leaving this unset disables the dashboard entirely (returns 503).
DASHBOARD_KEY="change-me"
